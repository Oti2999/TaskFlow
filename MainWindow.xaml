<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TodoApp"
        mc:Ignorable="d"
        Title="TaskFlow"
        Height="750"
        Width="1200"
        Background="#171821">

    <Grid>

        <!-- Fő oszlopok -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="215"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Bal oldalsáv -->
        <Border Grid.Column="0"
                Background="#1E202B">

            <StackPanel Margin="25,30,15,20">

                <TextBlock Text="◆  TaskFlow"
                           Foreground="#8B7CFF"
                           FontSize="25"
                           FontWeight="Bold"/>

                <TextBlock Text="MENU"
                           Foreground="#777B91"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="0,35,0,15"/>

                <Button Content="▦   Dashboard"
                        Background="#343047"
                        Foreground="#FFFFFF"
                        FontSize="14"
                        HorizontalContentAlignment="Left"
                        Padding="15,12"
                        BorderThickness="0"
                        Margin="0,0,0,8"/>

                <Button Content="☷   My Tasks"
                        Background="Transparent"
                        Foreground="#A0A3B5"
                        FontSize="14"
                        HorizontalContentAlignment="Left"
                        Padding="15,12"
                        BorderThickness="0"
                        Margin="0,0,0,8"/>

                <Button Content="◷   Upcoming"
                        Background="Transparent"
                        Foreground="#A0A3B5"
                        FontSize="14"
                        HorizontalContentAlignment="Left"
                        Padding="15,12"
                        BorderThickness="0"
                        Margin="0,0,0,8"/>

                <Button Content="✓   Completed"
                        Background="Transparent"
                        Foreground="#A0A3B5"
                        FontSize="14"
                        HorizontalContentAlignment="Left"
                        Padding="15,12"
                        BorderThickness="0"/>

            </StackPanel>

        </Border>

        <!-- Jobb oldal -->
        <Grid Grid.Column="1"
              Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- FEJLÉC -->
            <StackPanel Grid.Row="0">

                <TextBlock Text="Good morning!"
                           Foreground="#FFFFFF"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="Here's what's happening with your tasks today."
                           Foreground="#A0A3B5"
                           FontSize="14"
                           Margin="0,8,0,0"/>

            </StackPanel>

            <!-- Stat -->
            <Grid Grid.Row="1"
                  Margin="0,30,0,25">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#252735"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0,0,10,0">

                    <StackPanel>

                        <TextBlock Text="Total Tasks"
                                   Foreground="#A0A3B5"
                                   FontSize="14"/>

                        <TextBlock Text="24"
                                   Foreground="White"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="1"
                        Background="#252735"
                        CornerRadius="12"
                        Padding="20"
                        Margin="5,0">

                    <StackPanel>

                        <TextBlock Text="In Progress"
                                   Foreground="#A0A3B5"
                                   FontSize="14"/>

                        <TextBlock Text="12"
                                   Foreground="#8B7CFF"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

                <Border Grid.Column="2"
                        Background="#252735"
                        CornerRadius="12"
                        Padding="20"
                        Margin="10,0,0,0">

                    <StackPanel>

                        <TextBlock Text="Completed"
                                   Foreground="#A0A3B5"
                                   FontSize="14"/>

                        <TextBlock Text="12"
                                   Foreground="#65D6A3"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- Todo -->
            <StackPanel Grid.Row="2">

                <TextBlock Text="My Tasks"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <Border Background="#252735"
                        CornerRadius="12"
                        Padding="20">

                    <TextBlock Text="Your tasks will appear here."
                               Foreground="#A0A3B5"
                               FontSize="14"/>

                </Border>

            </StackPanel>

        </Grid>

    </Grid>

</Window>
